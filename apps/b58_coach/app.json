{
  "id": "b58_coach",
  "title": "Verbrauchs-Coach",
  "description": "Dein echter Spritverbrauch aus dem Einspritzzähler: jetzt gegen das, was dein M340i bei gleichem Tempo warm üblicherweise braucht, je Fahrt mit Kosten, wie Tempo, Außentemperatur, Fahrmodus und Klima ihn verändern, und was Kaltstarts und Kurzstrecken kosten",
  "version": "0.1.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "B5VC",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and reads only while the engine runs",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "engine speed, temperature and state: the coolant comes from the engine unit, auto start/stop is not told apart",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "the fuel injection counter: the fuel comes from the engine unit's own flow, read every second",
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "the tank level and the car's range: no range at the current consumption",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode (Eco Pro, Comfort, Sport): no consumption per mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "_optional": "climate on or off: no consumption with and without it",
      "statusClimateSystemOn": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Verbrauchs-Coach",
      "buttons": [
        [
          "BTN_PAGE",
          "Nächste Seite"
        ],
        [
          "BTN_PREV",
          "Vorherige Seite"
        ],
        [
          "BTN_SETTINGS",
          "Einstellungen"
        ]
      ]
    }
  ],
  "settings": [
