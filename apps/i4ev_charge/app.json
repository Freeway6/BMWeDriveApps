{
  "id": "i4ev_charge",
  "title": "Charge Curve",
  "description": "Records every charge while the head unit is on: power over charge level, cell temperature, energy, time per 10 % and cost, compared with your best charge; learns what this car really takes at each charge and temperature (Precondition uses it)",
  "version": "0.1.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "I4CH",
  "iconGlyph": "battery",
  "mguHmi": ["ID7", "ID8"],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and checks for a charge only while the head unit is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "the battery temperature the car sends itself (the cells' are read from the battery unit)",
      "statusBatteryTemperature": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "_optional": "the pack voltage the car sends itself (Diagnostics page only)",
      "statusHighVoltageStorage": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Charge Curve",
      "buttons": [
        ["BTN_ACT", "Next charge"],
        ["BTN_PIN", "Pin as reference"],
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    { "key": "target", "label": "Time to charge level", "type": "choice", "default": "80",
      "options": [["80", "80 %"], ["90", "90 %"], ["100", "100 %"]] },
    { "key": "sample", "label": "Read while charging every", "type": "number", "unit": "s", "default": 2, "steps": [2, 5, 10] },
    { "key": "priceDc", "label": "DC charging price", "type": "number", "unit": "EUR/kWh", "default": 0.59,
      "steps": [0, 0.29, 0.34, 0.39, 0.44, 0.49, 0.52, 0.54, 0.57, 0.59, 0.62, 0.64, 0.69, 0.74, 0.79, 0.84, 0.89] },
    { "key": "priceAc", "label": "AC charging price", "type": "number", "unit": "EUR/kWh", "default": 0.3,
      "steps": [0, 0.1, 0.15, 0.2, 0.25, 0.28, 0.3, 0.32, 0.35, 0.39, 0.44, 0.49, 0.54, 0.59] },
    { "key": "logAc", "label": "Record AC charges too", "type": "bool", "default": true },
    { "key": "battery", "label": "Battery", "type": "choice", "default": "83.9",
      "options": [["83.9", "83.9 kWh (eDrive40, xDrive40, M50)"], ["70.2", "70.2 kWh (eDrive35)"]] },
    { "key": "signMode", "label": "Battery current direction", "type": "choice", "default": "auto",
      "options": [["auto", "Auto (learned)"], ["normal", "As in app.json"], ["reversed", "Reversed"]] },
    { "key": "tempUnit", "label": "Temperature unit", "type": "choice", "default": "c", "options": [["c", "Celsius"], ["f", "Fahrenheit"]] },
    { "key": "diagPage", "label": "Diagnostics page (UDS replies, signals)", "type": "bool", "default": false },
    { "key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
      "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]] },
    { "key": "layout", "label": "Screen layout", "type": "choice", "default": "full", "options": [["full", "Full screen"], ["standard", "Standard"]] },
    { "key": "renderer", "label": "Renderer", "type": "choice", "default": "auto", "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]] },
    { "key": "demo", "label": "Demo data", "type": "choice", "default": "auto", "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]] }
  ],
  "config": {
    "hv": {
      "comment": "UDS identifiers of the high-voltage battery (lib/ev_hv.js DEFAULTS has the full lists: soc, energy, volt, amp, temp, cellV, odo, dcPlug). A key here replaces that list for this app, e.g. \"amp\": [{ \"did\": \"E561\", \"bytes\": 4, \"factor\": 0.01, \"signed\": true, \"min\": -1000, \"max\": 1000 }]. powerSign: kW out of the battery = V x A / 1000 x powerSign; the app learns it by itself (setting Battery current direction)."
    }
  }
}
