  "config": {
    "hv": {
      "comment": "UDS identifiers of the high-voltage battery (lib/ev_hv.js DEFAULTS has the full lists: soc, energy, volt, amp, temp, cellV, odo, dcPlug). A key here replaces that list for this app, e.g. \"amp\": [{ \"did\": \"E561\", \"bytes\": 4, \"factor\": 0.01, \"signed\": true, \"min\": -1000, \"max\": 1000 }]. powerSign: kW out of the battery = V x A / 1000 x powerSign; the app learns it by itself (setting Battery current direction)."
    },
    "live": {
      "comment": "The relay the head unit sends the charge to (relay/README.md): its address, e.g. https://i4-live.<name>.workers.dev. Empty: live is off. tls: fallback (the default: without a checked certificate when neither Node 8 nor lib/ev_roots.js know its root; the content stays end-to-end encrypted) or strict.",
      "relay": "https://i4-live.bmw-e75601.workers.dev",
      "tls": "fallback"
    }
  }
}
