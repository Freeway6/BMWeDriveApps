{
  "id": "i4ev_charge",
  "title": "Ladekurve",
  "description": "Zeichnet jede Ladung auf, solange die Headunit an ist: Leistung über dem Ladestand, Zelltemperatur, Energie, Zeit je 10 % und Kosten, verglichen mit deiner besten Ladung; lernt, was dein Auto bei welchem Ladestand und welcher Temperatur wirklich lädt (die Vorkonditionierung nutzt das). Auf Wunsch live auf iPhone und Apple Watch (Ende-zu-Ende verschlüsselt, über das Internet-Uplink des Stores)",
  "version": "0.3.0",
  "autostart": true,
  "internet": true,
  "vendor": "custom",
  "loggingId": "I4CH",
  "iconGlyph": "battery",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and checks for a charge only while the head unit is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "the battery temperature the car sends itself (the cells' are read from the battery unit)",
      "statusBatteryTemperature": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "_optional": "the pack voltage the car sends itself (Diagnostics page only)",
      "statusHighVoltageStorage": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ladekurve",
      "buttons": [
        [
          "BTN_ACT",
