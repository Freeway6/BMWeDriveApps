{
  "id": "i4ev_regen",
  "title": "Recuperation",
  "description": "What braking and lifting off give back: energy recovered per drive and in total, its share of what driving used and the range it added, and for every stop how much of the car's motion came back into the battery, by how hard you braked",
  "version": "0.1.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "I4RG",
  "iconGlyph": "brake",
  "mguHmi": ["ID7", "ID8"],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and reads only while a drive is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode (Sport, Personal, Efficient) per drive",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Recuperation",
      "buttons": [
        ["BTN_PAGE", "Next page"],
        ["BTN_PREV", "Previous page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    { "key": "mass", "label": "Car with people and load", "type": "number", "unit": "kg", "default": 2365,
      "steps": [2100, 2150, 2200, 2250, 2300, 2365, 2400, 2450, 2500, 2550, 2600, 2650, 2700] },
    { "key": "sample", "label": "Read the battery while driving every", "type": "number", "unit": "s", "default": 1, "steps": [0.5, 1, 2] },
    { "key": "distUnit", "label": "Distance unit", "type": "choice", "default": "km", "options": [["km", "km"], ["mi", "miles"]] },
    { "key": "diagPage", "label": "Diagnostics page (UDS replies, signals)", "type": "bool", "default": false },
    { "key": "signMode", "label": "Battery current direction", "type": "choice", "default": "auto",
      "options": [["auto", "Auto (learned)"], ["normal", "As in app.json"], ["reversed", "Reversed"]], "when": { "diagPage": true } },
    { "key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
      "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]] },
    { "key": "layout", "label": "Screen layout", "type": "choice", "default": "full", "options": [["full", "Full screen"], ["standard", "Standard"]] },
    { "key": "renderer", "label": "Renderer", "type": "choice", "default": "auto", "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]] },
    { "key": "demo", "label": "Demo data", "type": "choice", "default": "auto", "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]] }
  ],
  "config": {
    "hv": {
      "comment": "UDS identifiers of the high-voltage battery: lib/ev_hv.js DEFAULTS (volt E54D, amp E561 and their fourth-generation alternatives). A key here replaces that list for this app."
    }
  }
}
