{
  "id": "i4ev_precond",
  "title": "Vorkonditionierung",
  "description": "Ist der Akku warm genug zum Schnellladen? Zelltemperatur, wie schnell sie steigt, die zu erwartende DC-Leistung und Zeit bis 80 % jetzt und bei warmem Akku, und was eine Ankunft in 10, 20 oder 30 Minuten bringt (gelernt aus den Ladungen der Ladekurve, wenn sie installiert ist)",
  "version": "0.2.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "I4PC",
  "iconGlyph": "temp",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and reads only while the head unit is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "the battery temperature the car sends itself (used when the battery unit's cell temperatures do not answer)",
      "statusBatteryTemperature": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Vorkonditionierung",
      "buttons": [
        [
          "BTN_ACT",
          "Jetzt lesen"
        ],
        [
          "BTN_PAGE",
          "Nächste Seite"
        ],
        [
          "BTN_PREV",
          "Vorherige Seite"
        ],
        [
          "BTN_SETTINGS",
          "Einstellungen"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "charger",
      "label": "Schnelllader",
      "type": "choice",
      "default": "300",
      "options": [
        [
          "50",
          "50 kW"
        ],
        [
          "100",
          "100 kW"
        ],
        [
          "150",
          "150 kW"
        ],
        [
          "200",
          "200 kW"
        ],
        [
          "300",
          "300 kW und mehr"
        ]
      ]
    },
    {
      "key": "target",
      "label": "Laden bis",
      "type": "choice",
      "default": "80",
      "options": [
        [
          "80",
          "80 %"
        ],
        [
          "90",
          "90 %"
        ],
        [
          "100",
          "100 %"
        ]
      ]
    },
    {
      "key": "warmAt",
      "label": "Warm genug ab (kälteste Zelle)",
      "type": "number",
      "unit": "°C",
      "default": 25,
      "steps": [
        20,
        22,
        25,
        28,
        30
      ]
    },
    {
      "key": "battery",
      "label": "Akku",
      "type": "choice",
      "default": "83.9",
      "options": [
        [
          "83.9",
          "83,9 kWh (eDrive40, xDrive40, M50)"
        ],
        [
          "70.2",
          "70,2 kWh (eDrive35)"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperatureinheit",
      "type": "choice",
      "default": "c",
      "options": [
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    },
    {
      "key": "battOffset",
      "label": "Akkutemperatur des Autos: Versatz",
      "type": "number",
      "unit": "°C",
      "default": -50,
      "steps": [
        -60,
        -50,
        -40,
        0
      ],
      "when": {
        "diagPage": true
      }
    },
    {
      "key": "diagPage",
      "label": "Diagnoseseite (UDS-Antworten, Signale)",
      "type": "bool",
      "default": false
    },
    {
      "key": "theme",
      "label": "Farbschema",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Rot"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Eisweiß"
        ],
        [
          "amber",
          "Nacht-Bernstein"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Bildschirmaufteilung",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Vollbild"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Darstellung",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU, 60 Bilder/s (Standard)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demodaten",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatisch"
        ],
        [
          "on",
          "Immer"
        ],
        [
          "off",
          "Nie"
        ]
      ]
    }
  ],
  "config": {
    "hv": {
      "comment": "UDS identifiers of the high-voltage battery: lib/ev_hv.js DEFAULTS (temp: DDC0 lowest, highest, average cell temperature). A key here replaces that list for this app."
    }
  }
}
