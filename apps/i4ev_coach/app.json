{
  "id": "i4ev_coach",
  "title": "Effizienz-Coach",
  "description": "Dein echter Verbrauch aus der Energie des Akkus: jetzt gegen das, was dein Auto bei gleichem Tempo üblicherweise braucht, je Fahrt, und wie Tempo, Außentemperatur, Fahrmodus und Klima ihn verändern, mit der Reichweite bei deiner jetzigen Fahrweise",
  "version": "0.2.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "I4EF",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and reads only while a drive is on",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the driving mode (Sport, Personal, Efficient): no consumption per mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "_optional": "climate on or off: no consumption with and without it",
      "statusClimateSystemOn": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Effizienz-Coach",
      "buttons": [
        [
          "BTN_PAGE",
          "Nächste Seite"
        ],
        [
          "BTN_PREV",
          "Vorherige Seite"
        ],
        [
          "BTN_SETTINGS",
          "Einstellungen"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "window",
      "label": "Verbrauch jetzt: über die letzten",
      "type": "number",
      "unit": "km",
      "default": 5,
      "steps": [
        2,
        5,
        10
      ]
    },
    {
      "key": "distUnit",
      "label": "Entfernungseinheit",
      "type": "choice",
      "default": "km",
      "options": [
        [
          "km",
          "km (kWh/100 km)"
        ],
        [
          "mi",
          "Meilen (mi/kWh)"
        ]
      ]
    },
    {
      "key": "tempUnit",
      "label": "Temperatureinheit",
      "type": "choice",
      "default": "c",
      "options": [
        [
          "c",
          "Celsius"
        ],
        [
          "f",
          "Fahrenheit"
        ]
      ]
    },
    {
      "key": "battery",
      "label": "Akku (wenn die Energie nicht lesbar ist)",
      "type": "choice",
      "default": "83.9",
      "options": [
        [
          "83.9",
          "83,9 kWh (80,7 nutzbar)"
        ],
        [
          "70.2",
          "70,2 kWh (67,1 nutzbar)"
        ]
      ]
    },
    {
      "key": "sample",
      "label": "Energie des Akkus lesen alle",
      "type": "number",
      "unit": "s",
      "default": 10,
      "steps": [
        5,
        10,
        20
      ]
    },
    {
      "key": "diagPage",
      "label": "Diagnoseseite (UDS-Antworten, Signale)",
      "type": "bool",
      "default": false
    },
    {
      "key": "theme",
      "label": "Farbschema",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Rot"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Eisweiß"
        ],
        [
          "amber",
          "Nacht-Bernstein"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Bildschirmaufteilung",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Vollbild"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Darstellung",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU, 60 Bilder/s (Standard)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demodaten",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatisch"
        ],
        [
          "on",
          "Immer"
        ],
        [
          "off",
          "Nie"
        ]
      ]
    }
  ],
  "config": {
    "hv": {
      "comment": "UDS identifiers: lib/ev_hv.js DEFAULTS (energy E5C7: stored and usable kWh; soc E5CE when the energy does not answer). A key here replaces that list for this app."
    }
  }
}
