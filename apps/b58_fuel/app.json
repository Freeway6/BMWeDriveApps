{
  "id": "b58_fuel",
  "title": "Sprit-Check",
  "description": "Welcher Kraftstoff lohnt sich für deinen B58? Je Tankfüllung und Sorte: Verbrauch, Kosten je 100 km, die vom Motor adaptierte Oktanzahl, die Zündrücknahme der Klopfregelung unter Last und die Qualitätseinstufung des Motorsteuergeräts, mit dem Vergleich der Sorten",
  "version": "0.1.0",
  "autostart": true,
  "vendor": "custom",
  "loggingId": "B5SC",
  "iconGlyph": "flag",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left: the app cannot tell, and reads only while the engine runs",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "the fuel injection counter: the fuel used comes from the tank level only",
      "statusInjectionVolume": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "_optional": "the accelerator pedal: high load is found from the engine speed and the sport display",
      "AngleAcceleratorPedal": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the sport display's power: high load is found from the pedal",
      "statusVehicleDynamicEngine": "rs"
    }
  },
