{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "uninstallable": true,
    "build": {
      "python": "tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": ["lib", "i18n", "kit/runtime", "kit/platform", "kit/tools/build.py", "kit/tools/pack_data.py", "kit/tools/localize.py",
        "kit/tools/locale-revisions.json", "kit/tools/oapgen", "oap-sdk"]
    }
  }
}
